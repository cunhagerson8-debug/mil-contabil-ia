# Conexão com PostgreSQL (banco criado pelas migrations em database/migrations/)
DATABASE_URL=postgresql://mil_app:CHANGE_ME@localhost:5432/mil_contabil_ia

# Pool de conexões
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000

# Autenticação
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12

# Servidor
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
GEMINI_API_KEY=
