# Conexões PostgreSQL distintas. DATABASE_URL deve usar login membro de mil_app;
# ADMIN_DATABASE_URL, login membro de mil_platform_admin e reservado a operações globais.
DATABASE_URL=postgresql://mil_app_login:CHANGE_ME@localhost:5432/mil_contabil_ia
ADMIN_DATABASE_URL=postgresql://mil_platform_login:CHANGE_ME@localhost:5432/mil_contabil_ia

# Usada apenas por scripts administrativos de migração, nunca pela API.
MIGRATIONS_DATABASE_URL=postgresql://mil_migration_login:CHANGE_ME@localhost:5432/mil_contabil_ia

# Pool de conexões
PG_POOL_MAX=10
PG_ADMIN_POOL_MAX=2
PG_IDLE_TIMEOUT_MS=30000

# Autenticação
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
# Chave aleatória independente do JWT_SECRET; mínimo 32 bytes.
# Deve ser provisionada também no executor de migrations para a 019.
RLS_CONTEXT_SECRET=CHANGE_ME_TO_A_DIFFERENT_RANDOM_SECRET_MIN_32_BYTES
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=12
INVITE_TOKEN_TTL_HOURS=72

# Servidor
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
GEMINI_API_KEY=
RESEND_API_KEY=
